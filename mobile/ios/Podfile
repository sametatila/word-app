# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# react-native-firebase Firebase'i varsayılan olarak SPM'den çekiyor; SPM ürünleri
# statik bağlamada her RNFB pod'una ayrı kopya gömüp bağlamada çift sembol
# üretiyor ve `pod install` bunu baştan reddediyor. Proje statik kitaplık
# kullandığı için Firebase CocoaPods'tan gelir.
$RNFirebaseDisableSPM = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Lernomi' do
  config = use_native_modules!

  # GoogleSignIn 9.x kendisiyle birlikte AppCheckCore'u getiriyor ve o Swift.
  # Podfile'da `use_frameworks!` YOK (statik kitaplık) — Swift bir pod'un statik
  # kitaplıkta derlenebilmesi için bağımlılıklarının modül haritası üretmesi
  # gerekiyor, bu ikisi varsayılan olarak üretmiyor. CocoaPods bu yüzden
  # "Swift pods cannot yet be integrated as static libraries" ile duruyordu.
  #
  # `use_modular_headers!` global açılmıyor: React Native'in kendi pod'larının
  # bir kısmı modüler başlıkla kırılıyor. Hatanın adıyla andığı iki pod hedefli
  # olarak açılıyor.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true
  # Firebase Messaging/Installations da bu ikisini modül olarak istiyor.
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'nanopb', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # Bu adım pod'ların gizlilik beyanlarını Lernomi/PrivacyInfo.xcprivacy'ye
    # birleştirir ve dosyayı YENİDEN YAZAR: içindeki XML yorumları her pod
    # install'da silinir, o yüzden gerekçeler burada duruyor.
    # - NSPrivacyCollectedDataTypeDeviceID: uzak bildirim (FCM) 2026-09-10'da
    #   açıldı; cihaz başına kayıt jetonu (`device_tokens`) saklanıyor ve
    #   Google'a gidiyor. Play'in tanımı Firebase installation ID'yi bu kutuya
    #   yazdığı için iki mağaza aynı şeyi söylesin diye burada da beyan ediliyor.
    #   Reklam kimliği toplanmıyor.
    # - NSPrivacyCollectedDataTypeCrashData + ...OtherDiagnosticData: yakalanmayan
    #   JS hataları (mesaj, yığın, ekran adı, uygulama sürümü) kendi sunucumuza
    #   gidiyor (`src/lib/errorReport` → `/api/client-errors`). Hesaba bağlanmıyor
    #   (Linked: false), üçüncü tarafa gitmiyor; amaç uygulamanın çalışması.
    #   Crashlytics 2026-09-23'te kaldırıldı, bu beyan birinci taraf raporlar için.
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 27 iOS 15'ten eski dağıtım hedefini hata sayıyor; bazı pod'lar
    # (GoogleSignIn, RevenueCat, nanopb ve _Privacy kaynak paketleri) hâlâ 9-13
    # istiyor. Uygulamanın kendi hedefi 15.1, altındakiler ona çekilir.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |bc|
        if bc.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.1
          bc.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
      end
    end
  end
end
