<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Cihaz dili tr/en/de değilse buna düşülür; arayüzün varsayılanı da Türkçe. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>tr</string>
	<key>CFBundleDisplayName</key>
	<string>Lernomi</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- App Store'un dil listesi ve sistem izin diyaloglarının dili buradan okunur.
	     Android karşılığı res/xml/locales_config.xml; ikisi aynı üç dili saymalı.
	     Metinler {tr,en,de}.lproj/InfoPlist.strings'te, hedefe InfoPlist.strings
	     variant grubuyla bağlı. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>tr</string>
		<string>en</string>
		<string>de</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<!-- Google Sign-In geri dönüş şeması: iOS OAuth istemcisinin TERS client id'si.
	     Sır değil (uygulama paketinde zaten gömülü). Web client id ile karıştırılmamalı:
	     idToken'ın aud'u web client id olmaya devam eder — bkz. lib/googleAuth.ts.
	     DEĞER YER TUTUCU: gerçek istemci açılınca buradaki ve googleAuth.ts'teki
	     IOS_CLIENT_ID BİRLİKTE doldurulur; biri dolup öteki boş kalırsa giriş
	     "invalid client" ile düşer. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.YER-TUTUCU</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- HTTPS dışında şifreleme yok. Beyan burada durmazsa App Store Connect her
	     yüklemede soruyor ve otomasyon takılıyor. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Konuşarak cevap verebilmen için mikrofon erişimi gerekiyor.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Söylediklerini metne çevirip cevabını değerlendirmek için konuşma tanıma kullanılıyor.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
