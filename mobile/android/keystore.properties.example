# Release imza anahtarı — GERÇEK dosyayı `keystore.properties` olarak kopyala
# (gitignore'da). storeFile app/ klasörüne göreli ya da mutlak yol.
# Üret: scripts/gen-release-keystore.sh (parmak izlerini de basar).
#
# BU DOSYA YOKSA release yapısı ÜRETİLMEZ: app/build.gradle derlemeyi durdurur.
# Yalnız deneme amaçlı bir release paketi gerekiyorsa kapı elle açılır —
# `./gradlew assembleRelease -PallowDebugSigning` — ve çıkan yapı `-devkey`
# sürüm ekiyle işaretlenir; o dosya ne mağazaya ne yan dağıtıma gidebilir.
storeFile=release.keystore
storePassword=DEĞİŞTİR
# ZATEN üretilmiş bir keystore varsa takma adı ESKİ haliyle (nomi) kalır;
# keystore.properties'te onu değiştirme, imzalama kırılır. Bu satır yalnız
# yeni üretilecek anahtar içindir.
keyAlias=lernomi
keyPassword=DEĞİŞTİR
