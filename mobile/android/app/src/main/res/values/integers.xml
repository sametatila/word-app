<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Ekran yönü — TELEFON değeri (bu dosya niteleyicisiz, yani sw < 600dp).

      1 = SCREEN_ORIENTATION_PORTRAIT. Telefonda yalnız dikey: düzen tek sütunlu
      ve dikey akış için kurulmuş; yatayda satır ölçüsü bozuluyor, klavye açılınca
      içerik alanı avuç içi kadar kalıyor.

      NEDEN SABİT DEĞİL DE KAYNAK: `android:screenOrientation` bir enum ama
      derlenmiş biçimi tamsayı, dolayısıyla `@integer/...` ile verilebiliyor ve
      kaynak niteleyicileriyle cihaza göre değişebiliyor. Manifest'e düz
      "portrait" yazılsaydı TABLET de dikeye kilitlenirdi; ayrı bir manifest ya
      da çalışma zamanı kütüphanesi eklemenin başka yolu yoktu.

      Tablet karşılığı values-sw600dp/integers.xml içinde.
    -->
    <integer name="screen_orientation">1</integer>
</resources>
