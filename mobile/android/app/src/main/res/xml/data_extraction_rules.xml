<?xml version="1.0" encoding="utf-8"?>
<!--
  YEDEK VE CİHAZDAN CİHAZA AKTARIM: HİÇBİR ŞEY TAŞINMIYOR.

  `allowBackup="false"` Android 12+ hedefleyen uygulamada yalnız bulut yedeğini
  kapatıyor; kabloyla/yakın cihazdan aktarım (device-transfer) yine yapılıyordu.
  Oturum çerezi (`app_webview`, şifresiz SQLite) ve AsyncStorage (RKStorage)
  böylece yeni telefona taşınıyordu: kilidi açık telefona kısa süre erişen biri
  kendi telefonunun kurulum ekranından oturumu alabiliyordu (güvenlik denetimi
  2026-10-03, D12). Asıl veri sunucuda; yeni cihazda giriş yapmak yetiyor.
  Keystore anahtarı zaten taşınmıyor, misafir jetonu kendiliğinden kalıyor.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
  </device-transfer>
</data-extraction-rules>
