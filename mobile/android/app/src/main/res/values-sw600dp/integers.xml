<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Ekran yönü — TABLET değeri (sw >= 600dp; Android'in kendi tablet eşiği ve
      içerik sütununun kırılımıyla aynı, bkz. lib/useLayout).

      13 = SCREEN_ORIENTATION_FULL_USER: dört yön de serbest ama kullanıcının
      otomatik döndürme ayarına saygılı. iPad'in Info.plist'teki dört yönüyle
      aynı davranış.

      Ayrıca targetSdk 36'da (Android 16) sistem geniş ekranlarda yönlendirme
      kısıtlarını zaten yok sayıyor; bu dosya aynı davranışı Android 15 ve
      altındaki tabletlere de getiriyor.
    -->
    <integer name="screen_orientation">13</integer>
</resources>
