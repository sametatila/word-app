<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Mikrofon YALNIZ yürüyüş modu ve konuşma alıştırmaları için gerekli; uygulamanın
         geri kalanı (kelime turları, dersler, okuma/dinleme/yazma) mikrofonsuz çalışır.
         required="false" olmasaydı RECORD_AUDIO'dan zorunlu özellik çıkarsanır ve Play
         mikrofonsuz cihazları dağıtım dışında bırakırdı. Karşılığında mikrofonsuz
         cihazda mikrofonlu girişler gizleniyor (bkz. lib/useMicrophone.ts). -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ekran-kapalı (güç tuşu) yürüyüş: arka planda mikrofon için mikrofon-tipli foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- notifee'nin eklediği kısıtlı izinler: hatırlatmalar WorkManager zamanlayıcısıyla kurulur,
         tam-zamanlı alarm kullanılmaz. Play "exact alarm" beyanı gerektirmesin diye düşülür. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />

    <!-- Konuşma tanıma servisini görebilmek için (Android 11+ paket görünürlüğü).
         Yoksa Voice.isAvailable() false döner ve yürüyüş modunda STT hiç açılmaz. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Tahminli geri (predictive back): targetSdk 36'da varsayilan zaten acik, bayrak
         BEYANI acik tutuyor ki targetSdk bir gun dusurulurse davranis sessizce degismesin.
         Ekranlar arasi onizleme ANIMASYONU bununla gelmiyor: RN 0.87.1 ReactActivity surekli
         etkin, duz bir OnBackPressedCallback kaydediyor (OnBackAnimationCallback degil) ve
         react-native-screens 4.27.0'da hicbir geri-animasyon geri cagrisi yok. Sistem bu yuzden
         mIsAnimationCallback=false gosteriyor; onizleme icin kitaplik destegi gerekiyor. -->
    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:localeConfig="@xml/locales_config"
      android:enableOnBackInvokedCallback="true"
      android:theme="@style/Theme.Lernomi.Splash"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:networkSecurityConfig="@xml/network_security_config"
      android:supportsRtl="true">
      <!-- GÖREV ELE GEÇİRME (StrandHogg) KORUMASI: `taskAffinity=""`.
           Varsayılan yakınlık paket adı; telefondaki kötü niyetli bir uygulama
           kendi etkinliğine aynı yakınlığı verip bizim görev yığınımıza
           yerleşebiliyor ve kullanıcı Lernomi'yi açtığını sanırken sahte bir
           giriş ekranı görüyordu. Boş yakınlık bu eşleşmeyi imkânsız kılıyor
           (Android güvenlik rehberi "StrandHogg", OWASP MASTG). Yalnız bu
           etkinlikte: uygulama geneline konsaydı kütüphanelerin kendi
           etkinlikleri (faturalandırma, Credential Manager) de etkilenirdi. -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|fontScale|density|locale|layoutDirection"
        android:launchMode="singleTask"
        android:taskAffinity=""
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- APP LINKS: e-postadaki iki bağlantı uygulamada açılsın.
             `autoVerify` Android'e alan adındaki .well-known/assetlinks.json'ı
             okutur; orada BU uygulamanın imza parmak izi yoksa doğrulama
             başarısız olur ve bağlantı eskisi gibi tarayıcıda açılır — yani
             eksik beyan bir şeyi bozmuyor, sadece özelliği açmıyor.

             YOLLAR TEK TEK: `/api/auth/*` gibi bir joker Google girişinin
             dönüş adresini (/api/auth/callback/google) de kapsar ve OAuth
             dönüşü uygulamaya sıçrayıp girişi kırardı. Sunucudaki beyan
             dosyası (`.well-known/apple-app-site-association` `APP_LINK_PATHS`)
             aynı ÜÇ yolu sayıyor; yorum bir süre "iki yol" diyordu ve
             `/auth/app` eklendiğinde geride kalmıştı. Üçü `check:parity`de
             karşılaştırılıyor. -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="www.lernomi.app" android:path="/reset-password" />
            <data android:scheme="https" android:host="www.lernomi.app" android:path="/api/auth/verify-email" />
            <!-- Tarayıcıda tamamlanan girişin uygulamaya dönüş adresi (Apple,
                 Android). `/auth/handoff` tek kullanımlık bir token üretip
                 buraya yönlendiriyor; uygulama token'ı oturuma çeviriyor
                 (bkz. lib/deepLink, App.tsx). Uygulama kurulu değilse aynı
                 adres tarayıcıda bir sayfa çiziyor, kullanıcı çıkmazda kalmıyor. -->
            <data android:scheme="https" android:host="www.lernomi.app" android:path="/auth/app" />
            <!-- DAVET BAĞLANTISI: paylaşılan profil adresi. Kullanıcı adı
                 değişken olduğu için `pathPrefix`. Uygulaması kurulu bir
                 kullanıcı arkadaşının bağlantısına dokunduğunda uygulama
                 açılıyor; oturumsuzsa `UserScreen` adı konmuş bir kart ve
                 "Giriş yap" düğmesi gösteriyor (web de oturum istiyor, yani
                 iki taraf eşit). -->
            <data android:scheme="https" android:host="www.lernomi.app" android:pathPrefix="/u/" />
            <!-- DAVET KODU BAĞLANTISI: bağı KODA DEĞİL DOKUNUŞA bağlıyor.
                 Bağ eskiden yalnız paywall'daki kod kutusuna yazılarak
                 kuruluyordu; o kutu iOS'ta 3.1.1 gerekçesiyle hiç çizilmiyor,
                 yani davet edilen iOS kullanıcısı bağı hiç kuramıyordu.
                 Uygulama kurulu değilse aynı adres webde bağı kuruyor.
                 Kod değişken olduğu için `pathPrefix`. -->
            <data android:scheme="https" android:host="www.lernomi.app" android:pathPrefix="/r/" />
        </intent-filter>
      </activity>
      <service
        android:name="com.lernomi.speech.LernomiWalkService"
        android:foregroundServiceType="microphone"
        android:exported="false" />

      <!-- FCM'in arka planda KENDİ çizdiği bildirim için varsayılanlar.
           Android 8+ kanalsız bildirimi sessizce düşürür: kanal kimliği hem
           sunucu gövdesinde hem burada yazılı ki hangi yoldan gelirse gelsin
           bildirim "reminder" kanalına düşsün. Simge de yerel hatırlatmalarla
           aynı — iki kaynaktan gelen bildirim aynı görünmeli. -->
      <!-- tools:replace ZORUNLU: react-native-firebase_messaging aynı meta-data'yı
           BOŞ değerle beyan ediyor, birleştirici iki farklı değeri kendi başına
           seçemiyor ve yapı "Manifest merger failed" ile duruyor. -->
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_channel_id"
        android:value="reminder"
        tools:replace="android:value" />
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_icon"
        android:resource="@drawable/ic_notification" />

      <!-- notifee kendi ön plan servisini (shortService) manifest'e ekliyor; biz onu hiç
           başlatmıyoruz (yalnız kanal + tetikleyici bildirim kullanıyoruz). Kullanılmayan
           bir FGS bileşeni Play tarafında gereksiz beyan ve inceleme sorusu demek. -->
      <service android:name="app.notifee.core.ForegroundService" tools:node="remove" />

      <!-- Güvenlik sertleştirmesi (MobSF M2): notifee'nin dışa açık (exported) iki
           bileşenini kapatıyoruz. İkisi de başka uygulamaya açık olmayı gerektirmiyor:

           NotificationReceiverActivity'nin intent-filter'ı YOK; yalnız bizim kendi
           PendingIntent'imizle (bildirim dokunuşu) aynı uygulama içinden açılıyor —
           same-app başlatma exported=false ile de çalışır. Dışa açık kalması, başka
           bir uygulamanın bu translucent aktiviteyi tetikleyebilmesi demekti.

           AlarmPermissionBroadcastReceiver yalnız SCHEDULE_EXACT_ALARM izni değişince
           (korumalı sistem yayını) tetikleniyor; ama biz exact-alarm kullanmıyoruz
           (SCHEDULE_EXACT_ALARM yukarıda kaldırıldı), yani bu receiver zaten işlevsiz.
           Tetikleyici bildirimlerin (trigger) ihtiyaç duyduğu NotificationAlarmReceiver
           ve RebootBroadcastReceiver release manifest'te ZATEN exported=false, dokunulmuyor. -->
      <activity android:name="app.notifee.core.NotificationReceiverActivity"
        android:exported="false" tools:replace="android:exported" />
      <receiver android:name="app.notifee.core.AlarmPermissionBroadcastReceiver"
        android:exported="false" tools:replace="android:exported" />
    </application>
</manifest>
