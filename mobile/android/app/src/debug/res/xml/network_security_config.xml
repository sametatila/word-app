<?xml version="1.0" encoding="utf-8"?>
<!--
  YALNIZ DEBUG: main/res/xml/network_security_config.xml'in yerine geçer.

  Manifest bir networkSecurityConfig verdiğinde Android `usesCleartextTraffic`
  bayrağını yok sayar; cleartext'i artık yalnız bu dosya açabilir. Debug yapı
  Metro'ya düz HTTP ile bağlanıyor (emülatörde 10.0.2.2, adb reverse ile
  localhost) ve bu dosya olmadan "CLEARTEXT communication … not permitted"
  ile JS paketini yükleyemiyordu. Cleartext yalnız bu üç yerel adrese açık;
  release main'deki dosyayı kullanır, orada cleartext yok.
-->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
    </domain-config>
</network-security-config>
