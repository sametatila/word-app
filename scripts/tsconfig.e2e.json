{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    "paths": {
      "server-only": [
        "./scripts/empty-module.ts"
      ],
      "@/lib/db": [
        "./scripts/test-db.ts"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "./**/*.ts",
    "../src/**/*.ts",
    "../src/**/*.tsx"
  ],
  "exclude": [
    "../node_modules"
  ]
}
