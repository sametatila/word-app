# Neon Postgres (Neon Console > Connection string > Pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Neon Auth (Neon Console > Auth > Configuration > Auth URL)
# Bu ikisi boşken uygulama "demo" modunda tek kullanıcıyla çalışır.
NEON_AUTH_BASE_URL=""
# En az 32 karakter. Üret: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# ── Sohbet ortağı (/sohbet) ────────────────────────────────────────────────
# Anahtarı olan ilk sağlayıcı kullanılır; sırayla: gemini → anthropic → github.
# Birden fazlası tanımlıysa birincil düşünce diğerine geçilir.
# Hiçbiri yoksa yalnızca /sohbet kapalı görünür, uygulamanın geri kalanı çalışır.

# Gemini — AI Studio ücretsiz katmanı. Bu iş için önerilen: bedava ve
# Türkçe/Almanca'da Llama'dan belirgin daha iyi. aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL=""            # varsayılan: gemini-2.0-flash-lite

# Anthropic — ücretli ama kural takibi en iyi olan.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""         # varsayılan: claude-opus-5 (EğitimKit claude-haiku-4-5 kullanıyor)

# GitHub Models — ücretsiz katman (Llama-3.3-70B), models:read yetkili PAT.
GITHUB_MODELS_API_KEY=""
GITHUB_MODELS_MODEL=""     # varsayılan: Llama-3.3-70B-Instruct

# Sırayı ezmek istersen: gemini | anthropic | github
CHAT_PROVIDER=""
