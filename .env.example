# ── Veritabanı ve kimlik ─────────────────────────────────────────────────────
# Self-hosted PostgreSQL.
DATABASE_URL="postgresql://lernomi:PAROLA@localhost:5432/lernomi"
# Better Auth sırrı; boşken giriş kapalı. Üret: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Kök adres (çerez + OAuth callback). Üretim: https://www.lernomi.app
BETTER_AUTH_URL="https://www.lernomi.app"
# /admin erişimi, virgülle ayrık.
ADMIN_EMAILS="sametatila@gmail.com"
# /studio (sosyal medya videoları) erişimi, YALNIZ stüdyo (kullanıcı verisi içeren panele giremez), virgülle ayrık. Admin zaten girer.
SOCIAL_EDITOR_EMAILS=""
# Google girişi (isteğe bağlı). Redirect URI: <kök>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple ile Giriş — NATIVE akış (iOS). Sunucu id token'ı Apple'ın açık
# anahtarıyla doğrular, client secret GEREKMEZ.
# Değer = iOS bundle kimliği (native token'ın aud'u), ör. app.lernomi.ios
APPLE_BUNDLE_ID=""
# Apple ile Giriş — TARAYICI akışı (web ve Android). Native yolun olmadığı iki
# yüzeyde tek seçenek bu ve bundle kimliğiyle çalışmaz: Apple Developer ›
# Identifiers'ta ayrı bir SERVICES ID isteniyor (ör. app.lernomi.web), birincil
# App ID olarak bundle seçilir, alan adı doğrulanır ve dönüş adresi
# <kök>/api/auth/callback/apple yazılır. Boşken web/Android'de düğme çizilmez.
APPLE_SERVICES_ID=""
# Services ID'ye alan adı eklenirken Apple'ın indirttiği doğrulama dosyasının
# GÖVDESİ. <kök>/.well-known/apple-developer-domain-association.txt olarak
# yayımlanır. Boşken dosya 404 döner ve alan adı doğrulanmamış kalır.
APPLE_DOMAIN_ASSOCIATION=""
# Client secret'ın (tarayıcı akışı) ve hesap silmede izin İPTALİNİN (App Store
# 5.1.1(v)) ortak bağımlılığı. Üçü birden dolu olmadan tarayıcı akışı açılmaz ve
# iptal adımı atlanır, silme yine tamamlanır. Kaynak: Apple Developer › Keys ›
# "Sign in with Apple" anahtarı (.p8). PRIVATE_KEY tek satırda, satır sonları \n.
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
# Android App Links parmak izi (.well-known/assetlinks.json).
# Play uygulamayı KENDİ anahtarıyla yeniden imzalıyor: buraya Play Console ›
# Uygulama imzalama › "Uygulama imzalama anahtarı sertifikası" SHA-256'sı
# yazılır, yükleme anahtarınınki DEĞİL. Virgülle birden çok verilebilir.
# Boşken dosya yayımlanmaz ve derin bağlantı tarayıcıda açılmaya devam eder.
ANDROID_CERT_SHA256=""
# Hız sınırı sayacı (Better Auth). Boşken sayaç BELLEKTE tutulur ve instance
# başına ayrı sayar: üç instance'lı üretimde yazılan sınır fiilen üç katı olur.
# Redis verilince sayaç üçünde ORTAK olur. Sert sınır yine nginx'te (limit_req).
REDIS_URL=""

# ── Bot koruması (Cloudflare Turnstile) ──
# İkisi de doluyken kayıt, giriş ve "şifremi unuttum" uçları jetonsuz isteği
# REDDEDER (400). Yani anahtarları açmadan önce jeton gönderen mobil sürümün
# mağazada olması gerekir; eski uygulamalar aksi hâlde giriş yapamaz.
# Site anahtarı geneldir (istemciye iner), gizli anahtar sunucuda kalır.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Mağaza inceleme hesapları: yalnız e-postayla girişte Turnstile istenmez (virgülle; lib/auth/captcha).
CAPTCHA_EXEMPT_EMAILS=""
# QA kullanıcısı: günlük sohbet turu sınırından muaf hesaplar (virgülle; lib/quota-exempt). Yalnız qa@lernomi.app.
CHAT_QUOTA_EXEMPT_EMAILS=""

# ── Misafir cihaz doğrulaması (Play Integrity) — lib/auth/play-integrity ──
# "Hesapsız devam et"te Android belgesi Google'a doğrulatılır, sonuç guest_attestations'a yazılır.
# log = yalnız kayıt; enforce = belgesiz/geçmeyen Android misafir açamaz (Aşama 3). Anahtar yolu boşken kip kapalıdır.
GUEST_ATTESTATION=""          # boş/off = kapalı (istemci belge istemez); log = kaydet; enforce = engelle (iOS muaf)
PLAY_INTEGRITY_KEY_PATH=""    # playintegrity kapsamlı servis hesabı JSON yolu (sunucuda /opt/lernomi/secrets, root:lernomi 0640)

# ── Sohbet / konuşma koçu (OpenAI uyumlu zincir; Cloudflare Workers AI birincil, Groq yedek) ──
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_TOKEN=""
CLOUDFLARE_AI_MODEL=""     # boş = @cf/google/gemma-4-26b-a4b-it
GROQ_API_KEY=""
GROQ_MODEL=""              # boş = openai/gpt-oss-120b
CHAT_PROVIDER=""           # sırayı ezmek için: cloudflare | groq
ASSESS_DAILY_LIMIT=""      # kullanıcı başına günlük AI değerlendirme, boş = 60
AI_MONTHLY_BUDGET_USD=""   # kullanıma göre ücretli servislerin aylık bütçesi ($, uyarı; kısma yok), boş = uyarı yok

# ── Seslendirme (TTS) — birincil yol Edge, anahtarsız; Azure yedek ──────────
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""     # germanywestcentral (TTS yedeği ve STT aynı kaynak)
EDGE_TTS_BROWSER_VERSION=""   # yalnız 403 gelirse: güncel Edge ana sürümü
# Defne/Aras'ın önceden üretilmiş sesleri (tts-map.json + m4a/). YAYIN ANAHTARI: boşsa kelimeler Edge
# karşılığıyla çalar; doluysa kelimeler YALNIZ bu dosyalardan (düşüş yok). Kapsam tam olmadan doldurma
# (scripts/tts-own-coverage.ts).
TTS_OWN_DIR=""
# Sosyal video çıktıları ve işçi durumu (scripts/social/worker.mjs yazar, stüdyo indirir). Sunucu: /opt/lernomi/social
SOCIAL_DIR=""
# Dinleme (k=l) ve okuma (k=r) katmanında hangi karakterin dosyası verilsin: "l:defne,r:defne". Boşsa
# Edge. Karakter, o katmandaki kapsamı TAM olunca eklenir (yoksa aynı diyalogda ses satır satır değişir).
TTS_OWN_LAYERS=""

# ── Konuşma tanıma (STT): yalnız ekran kapalı yürüyüş (mobil) — azure → deepgram → groq ──
# Ekran açıkken ses sunucuya gitmez: cihazın / tarayıcının tanıyıcısı (2026-09-27).
DEEPGRAM_API_KEY=""
DEEPGRAM_STT_MODEL=""      # boş = nova-3
GROQ_STT_MODEL=""          # boş = whisper-large-v3-turbo
STT_ORDER=""               # sırayı ezmek: "deepgram,azure"
AZURE_STT_MONTHLY_SECONDS=""   # Azure aylık tavan (sn), boş = 16200

# ── Bildirim ve cron ─────────────────────────────────────────────────────────
# VAPID çifti: npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@ornek.com"
# Firebase Cloud Messaging — mobil (Android + iOS) uzak bildirim. Üçü de
# doluyken açılır, biri bile boşsa native push sessizce kapalı kalır.
# Kaynak: Firebase konsolu > Proje ayarları > Hizmet hesapları > yeni özel anahtar.
# Özel anahtar TEK SATIR: gerçek satır sonları yerine \n yazılır.
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""
# /api/cron/* için Authorization sırrı. Üret: openssl rand -hex 32
CRON_SECRET=""

# ── E-posta (SMTP) ───────────────────────────────────────────────────────────
# Doğrulama + parola sıfırlama gönderimi. HOST/USER/PASS üçü de doluyken e-posta
# doğrulaması ZORUNLU olur; boşken doğrulama kapalı + bağlantı log'a düşer.
# Sağlayıcı: Resend (SMTP ile; kod değişikliği gerekmiyor, nodemailer kullanır).
#   SMTP_HOST=smtp.resend.com · SMTP_PORT=2587 · SMTP_USER=resend
#   SMTP_PASS=<Resend API anahtari> · SMTP_FROM="Lernomi <noreply@lernomi.app>"
# Gönderen alan adının Resend'de doğrulanmış olması şart (SPF + DKIM).
SMTP_HOST=""
SMTP_PORT=""               # 2587 (Netcup 25/465/587'yi kapatıyor); boş = 587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""               # boş = "Lernomi <noreply@lernomi.app>"

# ── Premium (RevenueCat) — altyapı hazır, kaynak sonra bağlanır (WP-90) ──────
REVENUECAT_WEBHOOK_AUTH=""   # RevenueCat panosundaki webhook Authorization sırrı; boş = premium webhook kapalı
REVENUECAT_ALLOW_SANDBOX=""   # boş = SANDBOX (TestFlight/Play iç test) yetki yazar ama "sandbox" işaretlenip gelirden düşülür; "0" = sandbox yok sayılır
REVENUECAT_API_KEY=""         # RevenueCat v2 gizli anahtarı (sk_…; metrics okuma + müşteri silme izni); boş = panelde gelir özeti kapalı, hesap silmede RC müşteri kaydı silinmez
REVENUECAT_PROJECT_ID=""      # RevenueCat proje kimliği (proj…); API anahtarıyla birlikte gerekir
# Grup kodu kampanyası (2 ay ücretsiz) — iPhone yolu: App Store Connect'te teklif kodlarının (promo2m-monthly/-yearly) ÖZEL kod değeri.
IOS_PROMO2M_CODE_MONTHLY=""   # boş = /g/<KOD> sayfası iPhone'da "yakında" der; dolu = Apple'ın bozdurma sayfasına yönlendirir
IOS_PROMO2M_CODE_YEARLY=""    # yıllık planın özel kod değeri; ikisi birlikte dolmalı
# Ömür boyu Premium (test kullanıcıları) — /api/cron/lifetime saatte bir, en fazla bitiş gününe ya da herkes katılana dek; adresler depoya yazılmaz.
LIFETIME_PREMIUM_EMAILS=""    # virgülle ayrılmış e-postalar; boş = tur kapalı
LIFETIME_PREMIUM_UNTIL=""     # tur bitiş günü (YYYY-MM-DD, dahil); boş = tur kapalı

# ── İşletim uyarıları (Telegram) — lib/alerts + /opt/lernomi/watchdog.sh ─────
TELEGRAM_BOT_TOKEN=""       # BotFather'ın verdiği bot jetonu; boş = uyarı gönderilmez
TELEGRAM_CHAT_ID=""         # uyarının düşeceği sohbet kimliği (bota bir mesaj yazıp getUpdates ile bulunur)

# ── Mağaza yorumları (panel /admin/reviews) — YALNIZ OKUMA yetkili, ayrı anahtarlar ──
# Mağaza kaydını yöneten asıl anahtarlar sunucuya GİRMEZ. Dosyalar /opt/lernomi/secrets (root:lernomi 0640).
STORE_REVIEWS_ASC_KEY_PATH=""   # App Store Connect "Customer Support" rollü .p8 yolu; boş = App Store yorumları kapalı
STORE_REVIEWS_ASC_KEY_ID=""     # o anahtarın Key ID'si
STORE_REVIEWS_ASC_ISSUER_ID=""  # App Store Connect Issuer ID
STORE_REVIEWS_PLAY_SA_PATH=""   # yalnız "uygulama bilgilerini görüntüleme" izinli servis hesabı JSON yolu; boş = Play yorumları kapalı

# ── Site ve ayar ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=""    # og:image/canonical; boş = BETTER_AUTH_URL
PRODUCTION_FLOOR=""        # kelime turunda üretim tabanı 0–0.8, boş = 0.2 (tavan kodda 0.4)
AVATAR_3D_BASE=""         # Nomi 3B avatar kataloğu kökü (katalog.json + katmanlar), ör. https://www.lernomi.app/avatar/v1; boş = 2B maskot
TEST_DATABASE_URL=""       # npm run test:e2e

# ── Sunucu altyapısı (uygulama kodu okumaz; systemd / webhook / nginx) ───────
NODE_ENV=""
PORT=""
