# Neon Postgres (Neon Console > Connection string > Pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Neon Auth (Neon Console > Auth > Configuration > Auth URL)
# Bu ikisi boşken uygulama "demo" modunda tek kullanıcıyla çalışır.
NEON_AUTH_BASE_URL=""
# En az 32 karakter. Üret: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# ── Sohbet ortağı (/sohbet) ve konuşma koçu (speaking + diyalog) ───────────
# Hepsi OpenAI uyumlu ve aynı zinciri paylaşıyor. Anahtarı olan ilk sağlayıcı
# birincil, kalanlar yedek; 429 alan sağlayıcı Retry-After kadar soğumaya
# alınıp sıranın sonuna atılıyor. Hiçbiri yoksa /sohbet kapalı görünür ve
# konuşma alıştırmaları çevrimdışı hâllerinde eksiksiz çalışmaya devam eder.
#
# Sıra dakikalık istek hakkına göre kuruldu, günlük token cömertliğine göre
# değil: ölçüm sohbette darboğazın token değil eşzamanlı istek olduğunu
# gösterdi (bkz. npm run test:chat).

# Mistral — 50 istek/dk, 25K token/dk, ayda 1 milyar token. Dakikalık hakkı
# en geniş olan, o yüzden birincil. console.mistral.ai
MISTRAL_API_KEY=""
MISTRAL_MODEL=""           # varsayılan: mistral-medium-latest

# Groq — en hızlısı (~191ms) ama 12K token/dk; bir tur ~1.7K token olduğu için
# pratikte ~7 istek/dk. İlk yedek. console.groq.com
GROQ_API_KEY=""
GROQ_MODEL=""              # varsayılan: llama-3.3-70b-versatile

# Cerebras — kalite ve hız iyi ama dakikada 5 istek; günlük 1M token bu tavanın
# arkasında erişilemez kalıyor. Son yedek. cloud.cerebras.ai
CEREBRAS_API_KEY=""
CEREBRAS_MODEL=""          # varsayılan: gpt-oss-120b

# Sırayı ezmek istersen: mistral | groq | cerebras
CHAT_PROVIDER=""

# ── Seslendirme (TTS) ───────────────────────────────────────────────────────
# Sesler Microsoft'un nöral sesleri. Birincil yol Edge'in okuma servisi ve o
# anahtar istemiyor — yani hiçbir şey tanımlamasan da ses çalışır.
#
# Aşağıdaki Azure anahtarı **yedek**. Edge yolu resmî bir API değil; Microsoft
# onu değiştirirse (kurulum sırasında bir kez oldu) Azure devreye girer ve
# uygulama sessizleşmez. Sesler birebir aynı, kullanıcı farkı duymaz.
#
# Ücretsiz F0 katmanı: ayda 500.000 karakter, süresi dolmuyor, kart istemiyor.
# Yalnızca Edge kırıldığında kullanıldığı için bu kota tampon olarak kalır.
# Portal > Speech service > Keys and Endpoint sayfasından alınır.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""     # kaynağı açarken seçtiğin bölge, ör. westeurope

# ── Testler ────────────────────────────────────────────────────────────────
# npm run test:e2e bunu kullanır. Bütün yazma işlemleri "e2e-user" kimliğiyle
# sınırlı (truncate/drop yok), o yüzden aynı Neon veritabanına verilebilir.
TEST_DATABASE_URL=""
