# ── Veritabanı ve kimlik ─────────────────────────────────────────────────────
# Self-hosted PostgreSQL (Neon değil).
DATABASE_URL="postgresql://lernomi:PAROLA@localhost:5432/lernomi"
# Better Auth sırrı; boşken giriş kapalı. Üret: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Kök adres (çerez + OAuth callback). Üretim: https://www.lernomi.app
BETTER_AUTH_URL="https://www.lernomi.app"
# /admin erişimi, virgülle ayrık.
ADMIN_EMAILS="sametatila@gmail.com"
# Google girişi (isteğe bağlı). Redirect URI: <kök>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple ile Giriş (isteğe bağlı, yalnız iOS uygulaması). Yalnız native idToken
# akışı: sunucu token'ı Apple'ın açık anahtarıyla doğrular, client secret GEREKMEZ.
# Değer = iOS bundle kimliği (native token'ın aud'u), ör. app.lernomi.ios
APPLE_BUNDLE_ID=""

# ── Sohbet / konuşma koçu (OpenAI uyumlu zincir; anahtarı olan ilk sağlayıcı birincil) ──
MISTRAL_API_KEY=""
MISTRAL_MODEL=""           # boş = mistral-medium-latest
GROQ_API_KEY=""
GROQ_MODEL=""              # boş = openai/gpt-oss-120b
CEREBRAS_API_KEY=""
CEREBRAS_MODEL=""          # boş = gpt-oss-120b
CHAT_PROVIDER=""           # sırayı ezmek için: mistral | groq | cerebras
ASSESS_DAILY_LIMIT=""      # kullanıcı başına günlük AI değerlendirme, boş = 60

# ── Seslendirme (TTS) — birincil yol Edge, anahtarsız; Azure yedek ──────────
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""     # ör. westeurope
EDGE_TTS_BROWSER_VERSION=""   # yalnız 403 gelirse: güncel Edge ana sürümü

# ── Konuşma tanıma (STT): groq → cloudflare → speechmatics → deepgram → mistral ──
# Ekran kapalı yürüyüş modu: azure → deepgram → whisper'lar.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_TOKEN=""
CLOUDFLARE_STT_MODEL=""    # boş = @cf/openai/whisper-large-v3-turbo
SPEECHMATICS_API_KEY=""
SPEECHMATICS_URL=""        # boş = https://asr.api.speechmatics.com
DEEPGRAM_API_KEY=""
DEEPGRAM_STT_MODEL=""      # boş = nova-3
GROQ_STT_MODEL=""          # boş = whisper-large-v3-turbo
STT_ORDER=""               # sırayı ezmek: "cloudflare,groq"
AZURE_STT_MONTHLY_SECONDS=""   # Azure aylık tavan (sn), boş = 16200

# ── Bildirim ve cron ─────────────────────────────────────────────────────────
# VAPID çifti: npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@ornek.com"
# /api/cron/* için Authorization sırrı. Üret: openssl rand -hex 32
CRON_SECRET=""

# ── E-posta (SMTP) ───────────────────────────────────────────────────────────
# Doğrulama + parola sıfırlama gönderimi. Üçü de doluyken e-posta doğrulaması
# ZORUNLU olur; boşken doğrulama kapalı + bağlantı log'a düşer (giriş çalışır).
SMTP_HOST=""
SMTP_PORT=""               # 587 (STARTTLS) ya da 465 (TLS); boş = 587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""               # boş = "Lernomi <noreply@lernomi.app>"

# ── Premium (RevenueCat) — altyapı hazır, kaynak sonra bağlanır (WP-90) ──────
REVENUECAT_WEBHOOK_AUTH=""   # RevenueCat panosundaki webhook Authorization sırrı; boş = premium webhook kapalı

# ── Site ve ayar ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=""    # og:image/canonical; boş = BETTER_AUTH_URL
PRODUCTION_FLOOR=""        # kelime turunda üretim payı 0–0.8, boş = 0.4
TEST_DATABASE_URL=""       # npm run test:e2e

# ── Sunucu altyapısı (uygulama kodu okumaz; systemd / webhook / nginx) ───────
NODE_ENV=""
PORT=""
REDIS_URL=""
WEBHOOK_SECRET=""          # push-to-deploy HMAC. Üret: openssl rand -hex 24
