# ── Veritabanı ve kimlik ─────────────────────────────────────────────────────
# Self-hosted PostgreSQL.
DATABASE_URL="postgresql://lernomi:PAROLA@localhost:5432/lernomi"
# Better Auth sırrı; boşken giriş kapalı. Üret: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Kök adres (çerez + OAuth callback). Üretim: https://www.lernomi.app
BETTER_AUTH_URL="https://www.lernomi.app"
# /admin erişimi, virgülle ayrık.
ADMIN_EMAILS="sametatila@gmail.com"
# Google girişi (isteğe bağlı). Redirect URI: <kök>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple ile Giriş — NATIVE akış (iOS). Sunucu id token'ı Apple'ın açık
# anahtarıyla doğrular, client secret GEREKMEZ.
# Değer = iOS bundle kimliği (native token'ın aud'u), ör. app.lernomi.ios
APPLE_BUNDLE_ID=""
# Apple ile Giriş — TARAYICI akışı (web ve Android). Native yolun olmadığı iki
# yüzeyde tek seçenek bu ve bundle kimliğiyle çalışmaz: Apple Developer ›
# Identifiers'ta ayrı bir SERVICES ID isteniyor (ör. app.lernomi.web), birincil
# App ID olarak bundle seçilir, alan adı doğrulanır ve dönüş adresi
# <kök>/api/auth/callback/apple yazılır. Boşken web/Android'de düğme çizilmez.
APPLE_SERVICES_ID=""
# Services ID'ye alan adı eklenirken Apple'ın indirttiği doğrulama dosyasının
# GÖVDESİ. <kök>/.well-known/apple-developer-domain-association.txt olarak
# yayımlanır. Boşken dosya 404 döner ve alan adı doğrulanmamış kalır.
APPLE_DOMAIN_ASSOCIATION=""
# Client secret'ın (tarayıcı akışı) ve hesap silmede izin İPTALİNİN (App Store
# 5.1.1(v)) ortak bağımlılığı. Üçü birden dolu olmadan tarayıcı akışı açılmaz ve
# iptal adımı atlanır, silme yine tamamlanır. Kaynak: Apple Developer › Keys ›
# "Sign in with Apple" anahtarı (.p8). PRIVATE_KEY tek satırda, satır sonları \n.
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
# Android App Links parmak izi (.well-known/assetlinks.json).
# Play uygulamayı KENDİ anahtarıyla yeniden imzalıyor: buraya Play Console ›
# Uygulama imzalama › "Uygulama imzalama anahtarı sertifikası" SHA-256'sı
# yazılır, yükleme anahtarınınki DEĞİL. Virgülle birden çok verilebilir.
# Boşken dosya yayımlanmaz ve derin bağlantı tarayıcıda açılmaya devam eder.
ANDROID_CERT_SHA256=""
# Hız sınırı sayacı (Better Auth). Boşken sayaç BELLEKTE tutulur ve instance
# başına ayrı sayar: üç instance'lı üretimde yazılan sınır fiilen üç katı olur.
# Redis verilince sayaç üçünde ORTAK olur. Sert sınır yine nginx'te (limit_req).
REDIS_URL=""

# ── Sohbet / konuşma koçu (OpenAI uyumlu zincir; anahtarı olan ilk sağlayıcı birincil) ──
MISTRAL_API_KEY=""
MISTRAL_MODEL=""           # boş = mistral-medium-latest
GROQ_API_KEY=""
GROQ_MODEL=""              # boş = openai/gpt-oss-120b
CEREBRAS_API_KEY=""
CEREBRAS_MODEL=""          # boş = gpt-oss-120b
CHAT_PROVIDER=""           # sırayı ezmek için: mistral | groq | cerebras
ASSESS_DAILY_LIMIT=""      # kullanıcı başına günlük AI değerlendirme, boş = 60

# ── Seslendirme (TTS) — birincil yol Edge, anahtarsız; Azure yedek ──────────
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""     # ör. westeurope
EDGE_TTS_BROWSER_VERSION=""   # yalnız 403 gelirse: güncel Edge ana sürümü

# ── Konuşma tanıma (STT): groq → cloudflare → speechmatics → deepgram → mistral ──
# Ekran kapalı yürüyüş modu: azure → deepgram → whisper'lar.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_TOKEN=""
CLOUDFLARE_STT_MODEL=""    # boş = @cf/openai/whisper-large-v3-turbo
SPEECHMATICS_API_KEY=""
SPEECHMATICS_URL=""        # boş = https://asr.api.speechmatics.com
DEEPGRAM_API_KEY=""
DEEPGRAM_STT_MODEL=""      # boş = nova-3
GROQ_STT_MODEL=""          # boş = whisper-large-v3-turbo
STT_ORDER=""               # sırayı ezmek: "cloudflare,groq"
AZURE_STT_MONTHLY_SECONDS=""   # Azure aylık tavan (sn), boş = 16200

# ── Bildirim ve cron ─────────────────────────────────────────────────────────
# VAPID çifti: npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@ornek.com"
# Firebase Cloud Messaging — mobil (Android + iOS) uzak bildirim. Üçü de
# doluyken açılır, biri bile boşsa native push sessizce kapalı kalır.
# Kaynak: Firebase konsolu > Proje ayarları > Hizmet hesapları > yeni özel anahtar.
# Özel anahtar TEK SATIR: gerçek satır sonları yerine \n yazılır.
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""
# /api/cron/* için Authorization sırrı. Üret: openssl rand -hex 32
CRON_SECRET=""

# ── E-posta (SMTP) ───────────────────────────────────────────────────────────
# Doğrulama + parola sıfırlama gönderimi. HOST/USER/PASS üçü de doluyken e-posta
# doğrulaması ZORUNLU olur; boşken doğrulama kapalı + bağlantı log'a düşer.
# Sağlayıcı: Resend (SMTP ile; kod değişikliği gerekmiyor, nodemailer kullanır).
#   SMTP_HOST=smtp.resend.com · SMTP_PORT=2587 · SMTP_USER=resend
#   SMTP_PASS=<Resend API anahtari> · SMTP_FROM="Lernomi <noreply@lernomi.app>"
# Gönderen alan adının Resend'de doğrulanmış olması şart (SPF + DKIM).
SMTP_HOST=""
SMTP_PORT=""               # 2587 (Netcup 25/465/587'yi kapatıyor); boş = 587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""               # boş = "Lernomi <noreply@lernomi.app>"

# ── Premium (RevenueCat) — altyapı hazır, kaynak sonra bağlanır (WP-90) ──────
REVENUECAT_WEBHOOK_AUTH=""   # RevenueCat panosundaki webhook Authorization sırrı; boş = premium webhook kapalı
REVENUECAT_ALLOW_SANDBOX=""   # "1" = SANDBOX olayları da yetki yazsın (YALNIZ test); boş = üretimde sandbox yok sayılır

# ── Site ve ayar ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=""    # og:image/canonical; boş = BETTER_AUTH_URL
PRODUCTION_FLOOR=""        # kelime turunda üretim payı 0–0.8, boş = 0.4
TEST_DATABASE_URL=""       # npm run test:e2e

# ── Sunucu altyapısı (uygulama kodu okumaz; systemd / webhook / nginx) ───────
NODE_ENV=""
PORT=""
# push-to-deploy HMAC. Üret: openssl rand -hex 24
# YORUM KENDİ SATIRINDA KALMALI: bu dosyayı systemd EnvironmentFile= ile
# okuyan tek unit lernomi-webhook ve satır-sonu yorumunu AYIKLAMAZ — “#” ve
# sonrası sırrın parçası olur, imza tutmaz, her push 401 döner (2026-09-04).
WEBHOOK_SECRET=""
