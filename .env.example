# ── Veritabanı (self-hosted PostgreSQL — Neon DEĞİL) ─────────────────────────
# Üretimde sunucunun kendi Postgres'i (localhost). Yerelde kendi Postgres'in.
DATABASE_URL="postgresql://wortspiel:PAROLA@localhost:5432/wortspiel"

# ── Kimlik doğrulama (self-hosted Better Auth — Neon Auth DEĞİL) ─────────────
# Kullanıcılar/oturumlar kendi Postgres'imizde. BETTER_AUTH_SECRET boşken
# uygulama derlenir ama giriş çalışmaz. Üret: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Uygulamanın kök adresi (çerez + OAuth callback). Üretim: https://www.exfe.me
BETTER_AUTH_URL="https://www.exfe.me"

# Yönetim panosu (exfe.me/admin) erişimi — virgülle ayrık e-postalar.
ADMIN_EMAILS="sametatila@gmail.com"

# Google ile giriş (İSTEĞE BAĞLI). Boşken Google düğmesi "yakında"da kalır,
# e-posta/parola tek başına çalışır. Google Cloud > OAuth "Web" client;
# Authorized redirect URI: https://www.exfe.me/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Sohbet ortağı (/sohbet) ve konuşma koçu (speaking + diyalog) ───────────
# Hepsi OpenAI uyumlu ve aynı zinciri paylaşıyor. Anahtarı olan ilk sağlayıcı
# birincil, kalanlar yedek; 429 alan sağlayıcı Retry-After kadar soğumaya
# alınıp sıranın sonuna atılıyor. Hiçbiri yoksa /sohbet kapalı görünür ve
# konuşma alıştırmaları çevrimdışı hâllerinde eksiksiz çalışmaya devam eder.
#
# Sıra dakikalık istek hakkına göre kuruldu, günlük token cömertliğine göre
# değil: ölçüm sohbette darboğazın token değil eşzamanlı istek olduğunu
# gösterdi (bkz. npm run test:chat).

# Mistral — 50 istek/dk, 25K token/dk, ayda 1 milyar token. Dakikalık hakkı
# en geniş olan, o yüzden birincil. console.mistral.ai
MISTRAL_API_KEY=""
MISTRAL_MODEL=""           # varsayılan: mistral-medium-latest

# Groq — en hızlısı (~191ms) ama 12K token/dk; bir tur ~1.7K token olduğu için
# pratikte ~7 istek/dk. İlk yedek. console.groq.com
GROQ_API_KEY=""
GROQ_MODEL=""              # varsayılan: openai/gpt-oss-120b (llama-3.3-70b Groq'tan kalktı)

# Cerebras — kalite ve hız iyi ama dakikada 5 istek; günlük 1M token bu tavanın
# arkasında erişilemez kalıyor. Son yedek. cloud.cerebras.ai
CEREBRAS_API_KEY=""
CEREBRAS_MODEL=""          # varsayılan: gpt-oss-120b

# Sırayı ezmek istersen: mistral | groq | cerebras (boş = anahtarı olan ilk)
CHAT_PROVIDER=""

# Kullanıcı başına günlük AI değerlendirme (yazma/konuşma) hakkı. Boş = 60.
ASSESS_DAILY_LIMIT=""

# ── Seslendirme (TTS) ───────────────────────────────────────────────────────
# Sesler Microsoft'un nöral sesleri. Birincil yol Edge'in okuma servisi ve o
# anahtar istemiyor — yani hiçbir şey tanımlamasan da ses çalışır.
#
# Aşağıdaki Azure anahtarı **yedek** ve isteğe bağlı. Edge yolu resmî bir API
# değil; Microsoft onu değiştirirse (kurulum sırasında bir kez oldu) Azure
# devreye girer ve uygulama sessizleşmez. Sesler birebir aynı, kullanıcı farkı
# duymaz.
#
# Ücretsiz F0 katmanı ayda 500.000 karakter veriyor ve süresi dolmuyor; ama
# Azure aboneliği açmak kart doğrulaması istiyor (kart çekilmiyor, yalnızca
# provizyon). Kurmak istemezsen boş bırak — uygulama Edge ile çalışmaya devam
# eder. Portal > Speech service > Keys and Endpoint sayfasından alınır.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""     # kaynağı açarken seçtiğin bölge, ör. westeurope

# Edge yolunun tarayıcı sürümü. Normalde gerekmiyor: sürüm tarihten türetilip
# Microsoft'un alt sınırının önünde tutuluyor. Yine de bir gün 403 gelirse
# buraya güncel Edge ana sürümünü (ör. 150) yazıp redeploy etmek yeter.
EDGE_TTS_BROWSER_VERSION=""

# ── Konuşma tanıma (STT) ve telaffuz puanı (WP-20) ─────────────────────────
# Yürüyüş modu (/api/stt) ve telaffuz puanı (/api/pronounce) aynı zinciri
# kullanır; anahtarı olan sağlayıcılar şu sırayla denenir, 429/400/5xx'te bir
# sonrakine geçilir (kota ölçümü: docs/plan/stt-capacity.md, npm run report:stt):
#   1. Groq Whisper  — GROQ_API_KEY (yukarıda). Ücretsiz: 28.800 sn ses/gün,
#      2.000 istek/gün, 20 istek/dk. Kelime zaman damgası verir (akıcılık).
#   2. Cloudflare Workers AI — 10.000 neuron/gün (~214 dk), dakika sınırı yok;
#      Groq'un dakika sınırı dolunca ikinci hat. Worker gerekmez, REST.
#      Account ID: dash.cloudflare.com > Workers & Pages > sağ sütun.
#      Token: My Profile > API Tokens > Create Token > "Workers AI" şablonu
#      (izin: Account · Workers AI · Read yeter).
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_TOKEN=""
CLOUDFLARE_STT_MODEL=""    # varsayılan: @cf/openai/whisper-large-v3-turbo
#   3. Speechmatics — ücretsiz 480 dk/ay, kart yok. portal.speechmatics.com > API Keys
SPEECHMATICS_API_KEY=""
SPEECHMATICS_URL=""        # varsayılan: https://asr.api.speechmatics.com (bölge uç noktası için)
#   4. Deepgram — 200 $ tek seferlik kredi (~430 saat). console.deepgram.com
DEEPGRAM_API_KEY=""
DEEPGRAM_STT_MODEL=""      # varsayılan: nova-3
#   5. Mistral Voxtral — MISTRAL_API_KEY (yukarıda) varsa son çare.
#
# Yürürken modunun EKRAN KAPALI yolu ayrı bir sıra kullanır: Azure → Deepgram →
# Whisper'lar. Azure (AZURE_SPEECH_KEY / AZURE_SPEECH_REGION, yukarıda, TTS ile
# ortak) yalnız bu yolda zincire girer; ekran açıkken tarayıcının kendi
# tanıyıcısı çalışır ve Azure'a istek gitmez. F0: 5 saat/ay, eşzamanlı 1 istek;
# sessizlikte uydurmuyor, güven bildiriyor (ölçüm: docs/plan/walk-stt.md).
# Aylık emniyet tavanı (saniye); aşılınca Azure o ay zincirden düşer:
AZURE_STT_MONTHLY_SECONDS=""   # varsayılan: 16200 (4,5 saat)
# Groq'un STT modelini ezmek için (varsayılan whisper-large-v3-turbo):
GROQ_STT_MODEL=""
# Sırayı ezmek / tek sağlayıcı denemek: STT_ORDER="cloudflare,groq" (listede olmayan denenmez)
STT_ORDER=""

# ── Hatırlatma bildirimleri (web push) ──────────────────────────────────────
# Uygulamanın geri çağırma kanalı bu. Anahtar çifti bir kez üretilir:
#   npx web-push generate-vapid-keys --json
# İkisi de boşken bildirim özelliği tamamen kapalı görünür — izin kartı
# çıkmaz, cron boş döner, uygulamanın geri kalanı etkilenmez.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Push servislerinin sorun çıktığında ulaşacağı adres; VAPID zorunlu kılıyor.
VAPID_SUBJECT="mailto:info@ornek.com"

# Cron uçlarını (/api/cron/reminders, /api/cron/summary, /api/cron/assess)
# koruyan sır. Üret: openssl rand -hex 32
# Self-hosted'da bir zamanlayıcı (systemd timer / harici cron) bu sır ile
# Authorization başlığında çağırır. Üretimde tanımsızsa uç 503 döner: herkese
# açık bir adresin bildirim musluğu olarak durmasındansa çalışmaması doğru.
CRON_SECRET=""

# ── Site adresi ─────────────────────────────────────────────────────────────
# Paylaşılan bağlantının önizlemesinde (og:image, canonical) kullanılan mutlak
# adres. Boş bırakılırsa BETTER_AUTH_URL kullanılır; özel bir alan istersen yaz.
NEXT_PUBLIC_SITE_URL=""

# ── Testler / ayar ──────────────────────────────────────────────────────────
# npm run test:e2e bunu kullanır. Bütün yazma işlemleri "e2e-user" kimliğiyle
# sınırlı (truncate/drop yok), o yüzden ayrı bir test veritabanına verilebilir.
TEST_DATABASE_URL=""

# Kelime turunda üretim turlarının en düşük payı (0–0.8; varsayılan 0.4 = KPI 2
# hedefi). 0 kapatır. Bkz. lib/session.ts raiseProductionFloor.
PRODUCTION_FLOOR=""
