# Neon Postgres (Neon Console > Connection string > Pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Neon Auth (Neon Console > Auth > Configuration > Auth URL)
# Bu ikisi boşken uygulama "demo" modunda tek kullanıcıyla çalışır.
NEON_AUTH_BASE_URL=""
# En az 32 karakter. Üret: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# ── Sohbet ortağı (/sohbet) ────────────────────────────────────────────────
# Hepsi OpenAI uyumlu; anahtarı olan ilk sağlayıcı birincil, kalanlar yedek.
# Limiti dolan / 429 veren sağlayıcı atlanır. Hiçbiri yoksa yalnızca /sohbet
# kapalı görünür, uygulamanın geri kalanı çalışır.

# Cerebras — ücretsizler arasında en hızlısı, 1M token/gün. Birincil bu.
# cloud.cerebras.ai
CEREBRAS_API_KEY=""
CEREBRAS_MODEL=""          # varsayılan: gpt-oss-120b

# Groq — ~500K token/gün, yine çok hızlı. İlk yedek. console.groq.com
GROQ_API_KEY=""
GROQ_MODEL=""              # varsayılan: llama-3.3-70b-versatile

# Mistral — ayda 1 milyar token (ücretsiz katmanın en cömerti) ama ~2 RPM.
# Sohbette tek başına yavaş kalır; taşma yedeği olarak sonda. console.mistral.ai
MISTRAL_API_KEY=""
MISTRAL_MODEL=""           # varsayılan: mistral-medium-latest

# Sırayı ezmek istersen: cerebras | groq | mistral
CHAT_PROVIDER=""
