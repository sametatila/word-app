# --- derleme çıktıları ---
.next/
out/
build/
dist/
# `out/` Next'in dışa aktarma dizini için var, ama deseni her seviyede
# eşleşiyor ve veri hattının ÇIKTILARINI da yutuyordu. O dosyalar bir derleme
# artığı değil, düzeltmelerin kendisi: veritabanı onlardan tohumlanıyor ve
# repoda durmazlarsa ilk `db:seed` hepsini siler.
!data/meanings/out/
!data/zurich/beispiel/out/
!data/en-de/out/
!data/lessons/vocab/out/
!data/lessons/patterns/out/
!data/lessons/meta/out/
!data/lessons/roleplay/out/
