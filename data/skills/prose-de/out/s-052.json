 },
 {
  "tr": "Hesaplanan ek ve gizli kutup.",
  "kind": "intro",
  "de": "Der berechnete Frageanhang und die verborgene Polarität."
 },
 {
  "tr": "Dil düzeyi ve büronun üç satırı.",
  "kind": "intro",
  "de": "Die Sprachebene und die drei Zeilen des Amtes."
 },
 {
  "tr": "Taviz sözcükleri ve mesafe zinciri.",
  "kind": "intro",
  "de": "Die Zugeständniswörter und die Kette der Distanz."
 },
 {
  "tr": "Şiirde silme ve metni aktaran üç fiil.",
  "kind": "intro",
  "de": "Die Tilgung im Gedicht und die drei Verben, die einen Text wiedergeben."
 },
 {
  "tr": "Bir cümlede kaç katman var? Sayarak dinle.",
  "kind": "intro",
  "de": "Wie viele Schichten stecken in einem Satz? Hör mit und zähl."
 },
 {
  "tr": "Aynı hareket iki dilde var. Peki aynı katta mı?",
  "kind": "intro",
  "de": "Denselben Zug gibt es in beiden Sprachen. Aber auch auf derselben Ebene?"
 },
 {
  "tr": "Üç ayrı büyüklükte delik ve iki ayrı başlangıç.",
  "kind": "intro",
  "de": "Drei Löcher von je anderer Größe und zwei verschiedene Satzanfänge."
 },
 {
  "tr": "Bir belgeyi bir arada tutan sözcükler hangileri?",
  "kind": "intro",
  "de": "Welche Wörter halten ein Dokument zusammen?"
 },
 {
  "tr": "Bakış açısı bir yer değil bir liste. Neyin listesi?",
  "kind": "intro",
  "de": "Die Perspektive ist kein Ort, sondern eine Liste. Eine Liste wovon?"
 },
 {
  "tr": "İki taviz, hiçbir ödün. Zincir neden bu kadar uzun?",
  "kind": "intro",
  "de": "Zwei Zugeständnisse, kein Nachgeben. Warum ist die Kette so lang?"
 },
 {
  "tr": "Üç cümle, üç ayrı başlangıç. Hangisi neyi öne alıyor?",
  "kind": "intro",
  "de": "Drei Sätze, drei verschiedene Anfänge. Welcher stellt was nach vorn?"
 },
 {
  "tr": "Yedinci ünitedeki silme geri döndü. Burada ne yapıyor?",
  "kind": "intro",
  "de": "Die Tilgung aus Einheit sieben ist zurück. Was tut sie hier?"
 },
 {
  "tr": "Aynı satır iki dil düzeyinde. Hangi kusur bağışlanıyor?",
  "kind": "intro",
  "de": "Dieselbe Zeile auf zwei Sprachebenen. Welcher Fehler wird verziehen?"
 },
 {
  "tr": "Görüşmeyi kısaltmak ile soruyu atlatmak arasındaki fark.",
  "kind": "intro",
  "de": "Der Unterschied zwischen einem gestrafften Gespräch und einer umgangenen Frage."
 },
 {
  "tr": "İki sözcüklük ek, üç ayrı karar. Ek neyi açığa çıkarıyor?",
  "kind": "intro",
  "de": "Ein Anhang aus zwei Wörtern, drei Entscheidungen. Was legt er offen?"
 },
 {
  "tr": "Bir metni aktarırken hangi fiili seçtiğin bir kuram seçmektir.",
  "kind": "intro",
  "de": "Welches Verb du bei der Wiedergabe eines Textes wählst, ist die Wahl einer Theorie."
 },
 {
  "tr": "Bir derste üç ayrı büyüklükte delik. Hangisini hangi dil kapatıyor?",
  "kind": "intro",
  "de": "In einer Lektion drei Löcher von je anderer Größe. Welches schließt welche Sprache?"
 },
 {
  "tr": "Yer başta, özne sonda.",
  "kind": "explain",
  "de": "Der Ort am Anfang, das Subjekt am Ende."
 },
 {
  "tr": "„„Albeit“ takes half of it back…“",
  "kind": "explain",
  "de": "„„Albeit“ takes half of it back…“"
 },
 {
  "tr": "„„Is“ arrives and the shape is closed.“",
  "kind": "explain",
  "de": "„„Is“ arrives and the shape is closed.“"
 },
 {
  "tr": "Üç katman: kip fiili, belirteç, edilgen.",
  "kind": "explain",
  "de": "Drei Schichten: Modalverb, Adverb, Passiv."
 },
 {
  "tr": "Fiil, nesne, yüklem; en sonda ortak ölçü.",
  "kind": "explain",
  "de": "Verb, Objekt, Prädikat; ganz am Ende das gemeinsame Maß."
 },
 {
  "tr": "İki belge, iki katman: iddia ile varsayım.",
  "kind": "explain",
  "de": "Zwei Dokumente, zwei Schichten: Behauptung und Annahme."
 },
 {
  "tr": "İkinci yarıda fiil yok; virgül onu tutuyor.",
