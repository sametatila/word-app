 },
 {
  "tr": "Gelecekten geriye bakmak. Hangi cümle bitmişi anlatıyor?",
  "kind": "intro",
  "de": "Aus der Zukunft zurückblicken. Welcher Satz spricht vom Abgeschlossenen?"
 },
 {
  "tr": "Yarık cümle ve mesafe. Ne ileri sürülüyor, ne sürülmüyor?",
  "kind": "intro",
  "de": "Spaltsatz und Abstand. Was wird behauptet und was nicht?"
 },
 {
  "tr": "Önce olan iş: „having“ + üçüncü hâl.",
  "kind": "explain",
  "de": "Das Frühere: „having“ + dritte Form."
 },
 {
  "tr": "İkinci yarık biçim: ışık isme düşüyor.",
  "kind": "explain",
  "de": "Die zweite Spaltform: das Licht fällt auf das Substantiv."
 },
 {
  "tr": "Bildiriyor ve aynı anda geri çekiliyor.",
  "kind": "explain",
  "de": "Es berichtet und tritt zugleich zurück."
 },
 {
  "tr": "Olumsuz çıkarım „can't have“ ile kuruluyor.",
  "kind": "explain",
  "de": "Der verneinte Schluss wird mit „can't have“ gebildet."
 },
 {
  "tr": "Yarık cümle bu kez bir yokluğu adlandırıyor.",
  "kind": "explain",
  "de": "Der Spaltsatz benennt hier ein Fehlen."
 },
 {
  "tr": "„„Yesterday I spoke to her“ keeps its order…“",
  "kind": "explain",
  "de": "„„Yesterday I spoke to her“ keeps its order…“"
 },
 {
  "tr": "Üç devrik örnek, en sonda yazarın kendi kuralı.",
  "kind": "explain",
  "de": "Drei umgestellte Beispiele, am Ende die eigene Regel des Autors."
 },
 {
  "tr": "„„Must have“ and „can't have“ read the evidence.“",
  "kind": "explain",
  "de": "„„Must have“ and „can't have“ read the evidence.“"
 },
 {
  "tr": "„„Having finished“ means the finishing came first.“",
  "kind": "explain",
  "de": "„„Having finished“ means the finishing came first.“"
 },
 {
  "tr": "Uzun yol, kısa yol, kendi konumumuz, en sonda çıkış.",
  "kind": "explain",
  "de": "Langer Weg, kurzer Weg, die eigene Position, am Ende der Ausweg."
 },
 {
  "tr": "Kişi, bütün bir düşünce, resmî biçim, en sonda kural.",
  "kind": "explain",
  "de": "Person, ein ganzer Gedanke, die förmliche Form, am Ende die Regel."
 },
 {
  "tr": "Üç tutanak satırı, en sonda yazarın kendi düzeltmesi.",
  "kind": "explain",
  "de": "Drei Protokollzeilen, am Ende die eigene Korrektur des Autors."
 },
 {
  "tr": "„„Can't have“. We can't have prevented the breakdown…“",
  "kind": "explain",
  "de": "„„Can't have“. We can't have prevented the breakdown…“"
 },
 {
  "tr": "Uzun yol, kısa yol, seçimin gerekçesi, en sonda sınama.",
  "kind": "explain",
  "de": "Langer Weg, kurzer Weg, der Grund der Wahl, am Ende die Probe."
 },
 {
  "tr": "Kapalı, karışık, yine kapalı, en sonda sınamanın kendisi.",
  "kind": "explain",
  "de": "Geschlossen, gemischt, wieder geschlossen, am Ende die Probe selbst."
 },
 {
  "tr": "Gelecekte bir tarihten geriye bakış: „will have“ + üçüncü hâl.",
  "kind": "explain",
  "de": "Rückblick von einem künftigen Datum: „will have“ + dritte Form."
 },
 {
  "tr": "„Putting „what I want to highlight“ first makes the room wait…“",
  "kind": "explain",
  "de": "„Putting „what I want to highlight“ first makes the room wait…“"
 },
 {
  "tr": "„„Nevertheless“ turns. The cost is high; nevertheless, we continue.“",
  "kind": "explain",
  "de": "„„Nevertheless“ turns. The cost is high; nevertheless, we continue.“"
 },
 {
  "tr": "„In speech nobody says that; they say „the colleague we delegate to“…“",
  "kind": "explain",
  "de": "„In speech nobody says that; they say „the colleague we delegate to“…“"
 },
 {
  "tr": "„„Apparently“ puts the source somewhere else and leaves me holding nothing.“",
  "kind": "explain",
  "de": "„„Apparently“ puts the source somewhere else and leaves me holding nothing.“"
 },
 {
  "tr": "„When there is no auxiliary to move, „do“ appears just so that something can move…“",
