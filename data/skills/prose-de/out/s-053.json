 },
 {
  "tr": "Bir satırda „we“ ve „they“. Hangisi hangi sözcüğü kullanıyor?",
  "kind": "intro",
  "de": "In einer Zeile „we“ und „they“. Wer benutzt welches Wort?"
 },
 {
  "tr": "„„Albeit“ takes no clause.“",
  "kind": "explain",
  "de": "„„Albeit“ takes no clause.“"
 },
 {
  "tr": "„„Less so“ makes no claim…“",
  "kind": "explain",
  "de": "„„Less so“ makes no claim…“"
 },
 {
  "tr": "„„Otherness“ is a relation.“",
  "kind": "explain",
  "de": "„„Otherness“ is a relation.“"
 },
 {
  "tr": "Bir satırda iki özne: „we“ ve „they“.",
  "kind": "explain",
  "de": "Zwei Subjekte in einer Zeile: „we“ und „they“."
 },
 {
  "tr": "Talep eden bir ilke; „be“, „is“ değil.",
  "kind": "explain",
  "de": "Ein forderndes Prinzip; „be“, nicht „is“."
 },
 {
  "tr": "Çekince burada zayıflık değil, dürüstlük.",
  "kind": "explain",
  "de": "Die Einschränkung ist hier keine Schwäche, sondern Ehrlichkeit."
 },
 {
  "tr": "İkinci yarı sıfatı da fiili de ödünç alıyor.",
  "kind": "explain",
  "de": "Die zweite Hälfte leiht sich Adjektiv und Verb."
 },
 {
  "tr": "„…and this one is honest: the „we“ is named…“",
  "kind": "explain",
  "de": "„…and this one is honest: the „we“ is named…“"
 },
 {
  "tr": "Cümle, delik, onarım; en sonda güvenli biçim.",
  "kind": "explain",
  "de": "Satz, Lücke, Reparatur; ganz am Ende die sichere Form."
 },
 {
  "tr": "İki belge: biri iddia ediyor, öteki varsayıyor.",
  "kind": "explain",
  "de": "Zwei Dokumente: das eine behauptet, das andere setzt voraus."
 },
 {
  "tr": "İki sözcük, ara söz, cümle başı; en sonda ölçü.",
  "kind": "explain",
  "de": "Zwei Wörter, ein Einschub, ein Satzanfang; ganz am Ende das Maß."
 },
 {
  "tr": "„A flood is nobody's fault and nobody's policy…“",
  "kind": "explain",
  "de": "„A flood is nobody's fault and nobody's policy…“"
 },
 {
  "tr": "„„rather good for“ is what you say about medicine.“",
  "kind": "explain",
  "de": "„„rather good for“ is what you say about medicine.“"
 },
 {
  "tr": "Soyut isim, yer, adlandırılmış „we“; en sonda bedel.",
  "kind": "explain",
  "de": "Abstraktes Nomen, Ort, ein genanntes „we“; ganz am Ende die Kosten."
 },
 {
  "tr": "İkinci yarıda fiil yok; iki yarı birbirine yaslanıyor.",
  "kind": "explain",
  "de": "In der zweiten Hälfte fehlt das Verb; die beiden Hälften lehnen sich aneinander."
 },
 {
  "tr": "„…„although“, which cannot stand without a clause behind it.“",
  "kind": "explain",
  "de": "„…„although“, which cannot stand without a clause behind it.“"
 },
 {
  "tr": "Sayfada yer, cümle ortasında yineleme, savda yer; en sonda ölçü.",
  "kind": "explain",
  "de": "Ein Ort auf der Seite, eine Wiederholung in der Satzmitte, ein Ort im Argument; ganz am Ende das Maß."
 },
 {
  "tr": "Dört seçenek, yansız yok, iki oda; en sonda betimleme ile yönerge.",
  "kind": "explain",
  "de": "Vier Möglichkeiten, keine neutrale, zwei Räume; ganz am Ende Beschreibung und Anweisung."
 },
 {
  "tr": "Kişi ile sayı, hesap, iki edilgen; en sonda sözcüğün getirdiği resim.",
  "kind": "explain",
  "de": "Person und Zahl, die Rechnung, zwei Passive; ganz am Ende das Bild, das das Wort mitbringt."
 },
 {
  "tr": "„„Locally customary“ cancels the noun it is attached to without changing a single fact in it.“",
