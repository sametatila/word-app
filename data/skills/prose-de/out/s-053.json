 {
  "tr": "„Hiç kimse“ demenin dört yolu. Hangisi yansız?",
  "kind": "intro",
  "de": "Vier Wege, „niemand“ zu sagen. Welcher ist neutral?"
 },
 {
  "tr": "„Albeit“ bir cümlecik istemiyor. Peki ne istiyor?",
  "kind": "intro",
  "de": "„Albeit“ verlangt keinen Nebensatz. Was verlangt es dann?"
 },
 {
  "tr": "Bir sayı mı, bir belge mi? Sözcükler neyi ölçüyor?",
  "kind": "intro",
  "de": "Eine Zahl oder ein Dokument? Was messen die Wörter?"
 },
 {
  "tr": "Bir sözcük ötekini iptal ediyor. Hangisi hangisini?",
  "kind": "intro",
  "de": "Ein Wort hebt das andere auf. Welches welches?"
 },
 {
  "tr": "„Less so“ neyi kısaltıyor? Azı söylemek neyi büyütüyor?",
  "kind": "intro",
  "de": "Was kürzt „Less so“ ab? Und was vergrößert es, weniger zu sagen?"
 },
 {
  "tr": "Yorum yetkisini kim tutuyor? Bir fiil neyi ele veriyor?",
  "kind": "intro",
  "de": "Wer hält die Deutungshoheit? Und was verrät ein Verb?"
 },
 {
  "tr": "Bir karşılaştırma iki cümle demek olabiliyor. Onarımı ne?",
  "kind": "intro",
  "de": "Ein Vergleich kann zwei Sätze bedeuten. Wie repariert man ihn?"
 },
 {
  "tr": "Bir okuma ne zaman bir alanı kaplar? Çekince nerede duruyor?",
  "kind": "intro",
  "de": "Wann überzieht eine Lesart ein ganzes Fach? Und wo steht die Einschränkung?"
 },
 {
  "tr": "İsim öbeği iki dilde iki ayrı uçtan yükleniyor. Hangisi nereden?",
