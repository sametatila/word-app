 {
  "tr": "Bir okuma ne zaman bir alanı kaplar? Çekince nerede duruyor?",
  "kind": "intro",
  "de": "Wann überzieht eine Lesart ein ganzes Fach? Und wo steht die Einschränkung?"
 },
 {
  "tr": "Bir satırda iki özne: „we“ ve „they“.",
  "kind": "explain",
  "de": "Zwei Subjekte in einer Zeile: „we“ und „they“."
 },
 {
  "tr": "Talep eden bir ilke; „be“, „is“ değil.",
  "kind": "explain",
  "de": "Ein forderndes Prinzip; „be“, nicht „is“."
 },
 {
  "tr": "Çekince burada zayıflık değil, dürüstlük.",
  "kind": "explain",
  "de": "Die Einschränkung ist hier keine Schwäche, sondern Ehrlichkeit."
 },
 {
  "tr": "İkinci yarı sıfatı da fiili de ödünç alıyor.",
  "kind": "explain",
  "de": "Die zweite Hälfte leiht sich Adjektiv und Verb."
 },
 {
  "tr": "İki belge: biri açıkça iddia ediyor, öteki yalnızca işaret ediyor.",
  "kind": "explain",
  "de": "Zwei Dokumente: Das eine behauptet offen, das andere deutet bloß an."
 },
 {
  "tr": "Metin ile gelenek: biri açıkça iddia ediyor, öteki yalnızca varsayıyor.",
  "kind": "explain",
  "de": "Text und Tradition: Das eine behauptet offen, das andere setzt nur voraus."
 },
 {
