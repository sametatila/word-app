     "de": "s Chind",
     "mevcutTr": "çocuk"
    },
    {
     "de": "d Chuchi",
     "mevcutTr": "mutfak"
    },
    {
     "de": "Ich hätt gern e Stückli Chäs.",
     "mevcutTr": "Bir parça peynir istiyorum."
    },
    {
     "de": "Das isch es chlises Huus.",
     "mevcutTr": "Bu küçük bir ev."
    },
    {
     "de": "Chumm, mir gönd go poschte.",
     "mevcutTr": "Hadi, alışverişe gidelim."
    }
   ]
